{
  "name": "slide-ng-themes",
  "private": true,
  "description": "The official themes of slide.ng, one npm package each",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write \"**/*.{json,md,yml}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"packages/*/{layouts,components,layers,styles}/**/*.{ts,html,css}\" \"examples/{layers,components}/**/*.{ts,html}\"",
    "format:check": "prettier --check \"**/*.{json,md,yml}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"packages/*/{layouts,components,layers,styles}/**/*.{ts,html,css}\" \"examples/{layers,components}/**/*.{ts,html}\"",
    "test": "node --test tests/*.test.mjs && node tests/themes.mjs && node tests/adev-code.mjs && node tests/adev-alerts.mjs && node tests/adev-media.mjs && node tests/demo-switcher.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
